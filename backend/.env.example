# Copy this file to .env and change the values
SECRET_KEY=change-me-to-a-long-random-string
SECURITY_PASSWORD_SALT=change-me-to-another-random-string

# Default admin account (created automatically on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Placement Cell Admin

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0
CELERY_TIMEZONE=Asia/Kolkata

# Email (MailHog by default: SMTP on 1025, web UI on http://localhost:8025)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_DEFAULT_SENDER=noreply@placement-portal.local
